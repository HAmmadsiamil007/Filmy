<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive launcher icon (API 26+). Background color comes from
  values/colors.xml (ic_launcher_background = #0B0D12), foreground is the
  play-triangle vector. Keeping them as separate layers lets the system apply
  parallax and shape-masking without baked-in PNGs.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
