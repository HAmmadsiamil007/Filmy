__pycache__/
*.py[cod]
*$py.class
.env
.venv
env/
venv/

# Obsidian: commit vault config, ignore per-user transient state
docs/.obsidian/workspace.json
docs/.obsidian/workspace-mobile.json
docs/.obsidian/cache
docs/.obsidian/plugins
docs/.obsidian/themes
docs/.obsidian/snippets

# Node / frontend
node_modules/
web/dist/
web/.vite/
*.tsbuildinfo   # tsc -b incremental cache — changes on every type-check

# Android / Gradle
android/.gradle/
android/build/
android/app/build/
android/.idea/
android/captures/
android/local.properties   # machine-specific sdk.dir= path — never commit
*.apk
*.aab
*.keystore
*.jks

# Stray local Obsidian vault at repo root (contains only a default Welcome.md).
