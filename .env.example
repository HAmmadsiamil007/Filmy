# Environment variables
# ---------------------------------------------------------------------------
# This backend reads NO environment variables in Python — by design.
# The API is config-free so it runs with `pip install` + `uvicorn api:app`.
# See docs/Decisions/ADR-005 Remote self-hosted backend.md.
#
# The only variable used anywhere is $PORT, and it is consumed by the SHELL
# (Procfile / Railway), not by Python. Vercel instead targets main.py.
# ---------------------------------------------------------------------------

# Port the server binds to. Provided by the platform on Heroku/Railway;
# default when run locally is 8000.
PORT=8000

# ---------------------------------------------------------------------------
# Client-side configuration lives in the client, not here:
#   web     -> localStorage  moviebox.apiBase   (Settings modal)
#   android -> SharedPreferences moviebox.apiBase (Settings screen)
# ---------------------------------------------------------------------------
